generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Issue {
  id          String   @id @default(cuid())
  identifier  String   @unique
  title       String
  description String?
  status      String   @default("Todo")
  priority    String   @default("Medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cycleId     String?
  cycle       Cycle?   @relation(fields: [cycleId], references: [id])
  roadmapId   String?
  roadmap     Roadmap? @relation(fields: [roadmapId], references: [id])

  // New conceptual relations
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
}

model Roadmap {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("Planned")
  targetDate  DateTime?
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
}

model Cycle {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projects    Project[]
  repos       Repository[]
  roadmaps    Roadmap[]
  issues      Issue[]
}

model Repository {
  id          String   @id @default(cuid())
  name        String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  issues      Issue[]
  builds      Build[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("Planned") // Planned, Active, Completed, Cancelled
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  issues      Issue[]
}

model Build {
  id          String   @id @default(cuid())
  branch      String   @default("main")
  status      String   @default("Success") // Success, Failure, Building
  commitMsg   String?
  commitHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
}

model Environment {
  id          String   @id @default(cuid())
  name        String   // Production, Staging, Development
  url         String?
  status      String   @default("Healthy") // Healthy, Degraded, Offline
  version     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  actor       String   // Human, Antigravity, System
  actorIcon   String?  // Avatar or icon name
  action      String
  target      String?  // E.g. FLX-105
  createdAt   DateTime @default(now())
}


