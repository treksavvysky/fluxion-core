generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Issue {
  id          String   @id @default(cuid())
  identifier  String   @unique
  title       String
  description String?
  status      String   @default("Todo")
  priority    String   @default("Medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cycleId     String?
  cycle       Cycle?   @relation(fields: [cycleId], references: [id])
  roadmapId   String?
  roadmap     Roadmap? @relation(fields: [roadmapId], references: [id])

  // New conceptual relations
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  changeLogs  ChangeLog[]
}

model Roadmap {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("Planned")
  targetDate  DateTime?
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
}

model Cycle {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  status      String       @default("Active")
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projects     Project[]
  repos        Repository[]
  roadmaps     Roadmap[]
  issues       Issue[]
  changeLogs   ChangeLog[]
  documents    Document[]
  repositories ProductRepository[]
  syncBatches  SyncBatch[]
}

model Repository {
  id          String   @id @default(cuid())
  name        String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  issues      Issue[]
  builds      Build[]
  changeLogs  ChangeLog[]
  documents   Document[]
  products    ProductRepository[]
}

model ProductRepository {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pathFilter   String?    // e.g. "src/services/auth/*" for monorepos mapping
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, repositoryId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("Planned") // Planned, Active, Completed, Cancelled
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  issues      Issue[]
  documents   Document[]
}

model Build {
  id          String   @id @default(cuid())
  branch      String   @default("main")
  status      String   @default("Success") // Success, Failure, Building
  commitMsg   String?
  commitHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
}

model Environment {
  id          String   @id @default(cuid())
  name        String   // Production, Staging, Development
  url         String?
  status      String   @default("Healthy") // Healthy, Degraded, Offline
  version     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  actor       String   // Human, Antigravity, System
  actorIcon   String?  // Avatar or icon name
  action      String
  target      String?  // E.g. FLX-105
  createdAt   DateTime @default(now())
}

model ChangeLog {
  id            String   @id @default(cuid())
  type          String   // Deployment, Migration, API Release, Config Change
  description   String
  reason        String?  // Why this change was made
  approvedBy    String   // E.g. George Loudon
  implementedBy String   // E.g. Antigravity or George Loudon
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issueId       String?
  issue         Issue?      @relation(fields: [issueId], references: [id])
  repoId        String?
  repo          Repository? @relation(fields: [repoId], references: [id])
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // Markdown article content
  category    String   @default("General") // Architecture, Schema, API, Guide, General
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  trigger     String   // BUILD_FAILURE, PR_OPENED, HEALTH_DEGRADED
  condition   String?  // branch == 'main', etc.
  action      String   // AUTO_DELEGATE, LOG_AUDIT, TRIGGER_SELF_HEALING
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncBatch {
  id            String      @id @default(cuid())
  batchKey      String      @unique // Client-generated idempotency key; replays return the stored result
  source        String      @default("trail-sync-lens")
  deviceId      String?
  status        String      @default("Pending") // Pending, Applied, Partial, Failed
  deltaCount    Int         @default(0)
  appliedCount  Int         @default(0)
  conflictCount Int         @default(0)
  rejectedCount Int         @default(0)
  capturedAt    DateTime?   // When the offline session ended on the device
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  deltas        SyncDelta[]
}

model SyncDelta {
  id              String    @id @default(cuid())
  batchId         String
  batch           SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  seq             Int
  op              String    // issue.create, issue.update, issue.approve, roadmap.update
  targetRef       String?   // Issue identifier (TRAIL-SYNC-3) or roadmap name being mutated
  payload         Json
  clientTimestamp DateTime  // When the operation happened on the offline device
  status          String    @default("Pending") // Applied, Conflict, Rejected
  resolution      String?   // Outcome detail, e.g. conflict reason
  resultRef       String?   // Identifier of the entity that was created/updated
  createdAt       DateTime  @default(now())

  @@unique([batchId, seq])
}




