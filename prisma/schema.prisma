generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Issue {
  id          String   @id @default(cuid())
  identifier  String   @unique
  title       String
  description String?
  status      String   @default("Todo") // Triage, Backlog, Todo, In Progress, Done, Cancelled — transitions enforced in src/lib/issues.ts
  priority    String   @default("Medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Agent contract (FLX-117): structured markdown handoff fields so an
  // agent can ingest an issue and act with near-zero ambiguity.
  context            String? // Why this work exists; surrounding state an executor must know
  acceptanceCriteria String? // Verifiable conditions that define "Done"
  technicalIntent    String? // Intended approach/constraints, when they matter

  // Goal tree (FLX-117): parent-child decomposition
  parentId    String?
  parent      Issue?   @relation("IssueHierarchy", fields: [parentId], references: [id])
  children    Issue[]  @relation("IssueHierarchy")

  // Triage dedup (Fionn M4, FLX-124): deterministic signature of
  // webhook-born failure signals; repeats increment occurrences.
  signature   String?
  occurrences Int      @default(1)
  lastSeenAt  DateTime?

  cycleId     String?
  cycle       Cycle?   @relation(fields: [cycleId], references: [id])
  roadmapId   String?
  roadmap     Roadmap? @relation(fields: [roadmapId], references: [id])

  // New conceptual relations
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  changeLogs  ChangeLog[]
  attestations CriterionAttestation[]
}

// Fionn M3 (FLX-123): evidence-backed attestation of an acceptance
// criterion. Keyed by a hash of the criterion text, so editing a criterion
// invalidates its stale attestations. Fluxion records evidence; it never
// executes verification itself.
model CriterionAttestation {
  id            String   @id @default(cuid())
  issueId       String
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  criterionHash String
  criterion     String   // criterion text at attestation time
  evidence      String
  attestor      String
  createdAt     DateTime @default(now())

  @@unique([issueId, criterionHash])
}

model Roadmap {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("Planned")
  targetDate  DateTime?
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
}

model Cycle {
  id             String   @id @default(cuid())
  slug           String?  @unique // minted from name at creation; nullable only for pre-FLX-129 rows
  name           String
  goal           String?  // the 1-2 sentence operational win for this sprint block
  status         String   @default("Planned") // Planned, Active, Completed — transitions enforced in src/lib/cycles.ts; at most one Active
  capacityPoints Int?     // projected point capacity (velocity weights: High=3, Medium=2, Low=1)
  startDate      DateTime
  endDate        DateTime
  issues         Issue[]
  documents      Document[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  status      String       @default("Active")
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projects     Project[]
  repos        Repository[]
  roadmaps     Roadmap[]
  issues       Issue[]
  changeLogs   ChangeLog[]
  documents    Document[]
  repositories ProductRepository[]
  syncBatches  SyncBatch[]
  commitRoutes CommitRoute[]
}

model Repository {
  id          String    @id @default(cuid())
  name        String
  url         String?
  archivedAt  DateTime? // soft-delete (FLX-137): archived records keep all history and can be restored; there is no destructive delete path
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  issues      Issue[]
  builds      Build[]
  changeLogs  ChangeLog[]
  documents   Document[]
  products    ProductRepository[]
  commits     Commit[]
}

model ProductRepository {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pathFilter   String?    // e.g. "src/services/auth/*" for monorepos mapping
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, repositoryId])
}

// Push-event ingest (FLX-119): commits recorded with their changed paths,
// routed to products by matching ProductRepository.pathFilter globs, with
// the repository's directly-linked product as the fallback for unmatched
// paths. Routing rows are derived data — recomputable from paths + filters.
model Commit {
  id          String    @id @default(cuid())
  sha         String
  message     String
  author      String?
  branch      String?
  committedAt DateTime?
  paths       String[]  // changed file paths (added + modified + removed)
  createdAt   DateTime  @default(now())

  repoId      String
  repo        Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  routes      CommitRoute[]

  @@unique([repoId, sha]) // webhook re-deliveries are idempotent
}

model CommitRoute {
  id           String   @id @default(cuid())
  commitId     String
  commit       Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  matchedPaths String[] // the commit paths that routed to this product
  via          String   // "pathFilter" | "repoDefault"
  createdAt    DateTime @default(now())

  @@unique([commitId, productId])
}

model Project {
  id          String    @id @default(cuid())
  slug        String?   @unique // minted from name at creation, immutable; nullable only for pre-FLX-125 rows
  name        String
  description String?
  status      String    @default("Planned") // Planned, Active, On Hold, Completed, Cancelled — transitions enforced in src/lib/projects.ts
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  issues      Issue[]
  documents   Document[]
  changeLogs  ChangeLog[]
}

model Build {
  id          String   @id @default(cuid())
  branch      String   @default("main")
  status      String   @default("Success") // Success, Failure, Building
  commitMsg   String?
  commitHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
}

model Environment {
  id          String   @id @default(cuid())
  name        String   // Production, Staging, Development
  url         String?
  status      String   @default("Healthy") // Healthy, Degraded, Offline
  version     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  actor       String   // Human, Antigravity, System
  actorIcon   String?  // Avatar or icon name
  action      String
  target      String?  // E.g. FLX-105
  createdAt   DateTime @default(now())
}

model ChangeLog {
  id            String   @id @default(cuid())
  type          String   // Deployment, Migration, API Release, Config Change
  description   String
  reason        String?  // Why this change was made
  approvedBy    String   // E.g. George Loudon
  implementedBy String   // E.g. Antigravity or George Loudon
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issueId       String?
  issue         Issue?      @relation(fields: [issueId], references: [id])
  repoId        String?
  repo          Repository? @relation(fields: [repoId], references: [id])
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // Markdown article content
  category    String   @default("General") // Architecture, Schema, API, Guide, General
  docType     String   @default("General") // Vision, Boundaries, Architecture, General — durable-doc slots per product (FLX-120)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  repoId      String?
  repo        Repository? @relation(fields: [repoId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  cycleId     String?
  cycle       Cycle?      @relation(fields: [cycleId], references: [id])
  revisions   DocumentRevision[]
}

// Snapshot of a document's prior state, written on every upsert-update
// (FLX-120). Keeps the durable strategic docs auditable without a CMS.
model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String
  category   String
  docType    String
  createdAt  DateTime @default(now())
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  trigger     String   // BUILD_FAILURE, PR_OPENED, HEALTH_DEGRADED
  condition   String?  // branch == 'main', etc.
  action      String   // AUTO_DELEGATE, LOG_AUDIT, TRIGGER_SELF_HEALING
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncBatch {
  id            String      @id @default(cuid())
  batchKey      String      @unique // Client-generated idempotency key; replays return the stored result
  source        String      @default("trail-sync-lens")
  deviceId      String?
  status        String      @default("Pending") // Pending, Applied, Partial, Failed
  deltaCount    Int         @default(0)
  appliedCount  Int         @default(0)
  conflictCount Int         @default(0)
  rejectedCount Int         @default(0)
  capturedAt    DateTime?   // When the offline session ended on the device
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  deltas        SyncDelta[]
}

model SyncDelta {
  id              String    @id @default(cuid())
  batchId         String
  batch           SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  seq             Int
  op              String    // issue.create, issue.update, issue.approve, roadmap.update
  targetRef       String?   // Issue identifier (TRAIL-SYNC-3) or roadmap name being mutated
  payload         Json
  clientTimestamp DateTime  // When the operation happened on the offline device
  status          String    @default("Pending") // Applied, Conflict, Rejected
  resolution      String?   // Outcome detail, e.g. conflict reason
  resultRef       String?   // Identifier of the entity that was created/updated
  createdAt       DateTime  @default(now())

  @@unique([batchId, seq])
}




